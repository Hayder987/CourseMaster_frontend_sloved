# Frontend Environment Variables

# Backend API Base URL
# Production build: keep exactly ONE active VITE_API_BASE_URL entry.
# VITE_API_BASE_URL=https://course-master-backend-ochre.vercel.app/api

# Local development: create `.env.local` (git-ignored) with
  VITE_API_BASE_URL=http://localhost:5000/api
# Vite loads `.env.local` with higher priority than `.env`.

VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_ADMIN_PASSWORD=Admin@123456

VITE_DEMO_STUDENT_EMAIL=student@coursemaster.com
VITE_DEMO_STUDENT_PASSWORD=student123